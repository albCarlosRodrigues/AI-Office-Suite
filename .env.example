# Public client configuration (not a secret)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only secrets: prefer the platform SecretStore.
LOVABLE_API_KEY=replace-with-secret-reference

# Windows DPAPI defaults to CurrentUser. Use LocalMachine explicitly only for
# service accounts whose user profile is unavailable.
# AI_OFFICE_DPAPI_SCOPE=LocalMachine

# Runtime limits
AI_OFFICE_GLOBAL_MAX_CONCURRENT_TASKS=4
AI_OFFICE_MAX_CONCURRENT_TASKS_PER_MISSION=2
AI_OFFICE_MAX_CONCURRENT_TOOL_EXECUTIONS=2
# Durable queue/state is separate from the operational store by default.
# AI_OFFICE_RUNTIME_FILE=C:\path\to\ai-office-runtime.json
